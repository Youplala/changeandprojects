---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import SculptureScene from '../components/SculptureScene.astro';
import Contact from '../components/Contact.astro';
import Arrow from '../components/Arrow.astro';
import { expertises, site } from '../data/site';
---
<BaseLayout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="small-line"></span> Formation · Conseil · Accompagnement</p>
      <h1 id="hero-title"><span class="hero-title-line"><span>Le changement</span></span><span class="hero-title-line"><span>est un <em>mouvement.</em></span></span></h1>
      <p class="hero-description">Donnons-lui du sens.<br/>Et avançons ensemble.</p>
      <div class="hero-actions">
        <a class="button button-red" href="#expertises">Faire le premier pas <Arrow /></a>
        <a class="hero-secondary" href={withBase('/formations/')}>Les formations <Arrow diagonal /></a>
      </div>
    </div>
    <figure class="hero-art">
      <span class="art-note">L’humain, toujours au centre.</span>
      <SculptureScene />
      <figcaption class="art-caption"><span>Chaque pas ouvre une possibilité.</span><small>L’Homme qui marche I · Alberto Giacometti</small></figcaption>
    </figure>
    <div class="hero-bottom"><span class="hero-person"><strong>Charles-Antoine Patarroni</strong><small>Consultant & formateur</small></span><span>Comprendre. Mobiliser. Avancer.</span><a href="#expertises" aria-label="Découvrir l’approche"><span>Explorer</span><span class="down-arrow">↓</span></a></div>
  </section>

  <section class="expertise-section wrap" id="expertises" aria-labelledby="expertises-title">
    <div class="section-intro"><p class="eyebrow">01 / L’approche</p><div><h2 id="expertises-title">Un cap clair.<br/>Une dynamique <em>collective.</em></h2><p>Les organisations évoluent quand les personnes avancent.<br class="desktop-break"/> Trois leviers pour transformer vos intentions en action.</p></div></div>
    <div class="expertise-list">{expertises.map((expertise) => <article class="expertise-row"><span class="row-number">{expertise.number}</span><h3>{expertise.title}</h3><p>{expertise.description}</p><span class="row-mark" aria-hidden="true"><Arrow diagonal /></span></article>)}</div>
    <div class="formation-invitation"><p>Apprendre aujourd’hui.<br/><strong>Faire autrement demain.</strong></p><a class="text-link" href={withBase('/formations/')}>Découvrir les formations <Arrow /></a></div>
  </section>

  <section class="about-section" id="charles-antoine" aria-labelledby="about-title">
    <div class="about-inner wrap"><div class="about-left"><p class="eyebrow">02 / Votre interlocuteur</p><figure class="about-portrait">
        <img src={withBase(site.portrait.src)} alt={site.portrait.alt} width={site.portrait.width} height={site.portrait.height} loading="lazy" decoding="async" />
        <figcaption class="experience-mark"><span>30<span class="plus">+</span></span><p>années d’expérience<br/>dans l’accompagnement<br/>des changements</p></figcaption>
      </figure><span class="about-location">Ancré à Niort. Ouvert sur vos projets.</span></div><div class="about-copy"><h2 id="about-title">Charles-Antoine<br/><em>Patarroni.</em></h2><p class="about-lead">L’expérience du changement.<br/>La conviction de l’humain.</p><p>Conseil, formation et accompagnement : mon métier est d’aider les organisations à évoluer, les projets à prendre forme et les équipes à développer leur potentiel.</p><p>Avec Change & Projects, je mets plus de 30 ans d’expérience au service d’une même ambition : faire du changement une démarche comprise, partagée et concrète.</p><a class="text-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">Découvrir mon parcours sur LinkedIn <Arrow diagonal /></a></div></div>
  </section>
  <Contact />
</BaseLayout>
