---
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Contact from '../../components/Contact.astro';
import Arrow from '../../components/Arrow.astro';
import { expertises, getPublishedTrainings } from '../../data/site';
const trainings = getPublishedTrainings();
---
<BaseLayout title="Les formations" description="Des formations pour comprendre le changement, faire avancer les projets et développer les équipes. Découvrez l’approche de Change & Projects.">
  <section class="page-hero wrap"><a class="breadcrumb" href={withBase('/')}>Accueil <span>/</span> <span>Les formations</span></a><p class="eyebrow">Apprendre pour avancer</p><h1>De nouveaux repères.<br/>De nouvelles <em>possibilités.</em></h1><div class="page-hero-bottom"><p>Le changement s’apprend aussi.<br/>Des compétences à développer, des pratiques à faire évoluer.</p><span class="page-number" aria-hidden="true">01 — 03</span></div></section>
  <section class="catalogue-section wrap" aria-labelledby="catalogue-title">
    <div class="catalogue-heading"><h2 id="catalogue-title">Les formations</h2><span class="eyebrow">{trainings.length ? `${trainings.length} programme${trainings.length > 1 ? 's' : ''}` : 'Catalogue en préparation'}</span></div>
    {trainings.length ? <div class="training-list">{trainings.map((training) => <a class="training-link" href={withBase(`/formations/${training.slug}/`)}><div><h3>{training.title}</h3><p>{training.summary}</p><span>{training.duration} · {training.format}</span></div><Arrow diagonal /></a>)}</div> : <div class="catalogue-empty"><div class="empty-symbol" aria-hidden="true"><span></span><span></span><span></span></div><div><h3>Les prochains pas se préparent.</h3><p>Les programmes de formation sont en cours de finalisation. Les objectifs, les durées et les modalités seront présentés ici une fois validés.</p><a class="text-link" href="#contact">Échangeons sur vos besoins <Arrow diagonal /></a></div></div>}
    <div class="training-domains"><p class="eyebrow">Les domaines d’expertise</p>{expertises.map((expertise) => <div class="domain-row"><span>{expertise.number}</span><h3>{expertise.tag}</h3></div>)}<p class="domain-note">Ces domaines présentent les expertises de Change & Projects. Ils ne constituent pas des programmes de formation ouverts à l’inscription.</p></div>
  </section>
  <Contact />
</BaseLayout>
