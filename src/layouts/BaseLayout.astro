---
import { withBase } from '../utils/paths';
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; }
const { title = 'Le changement se met en mouvement', description = site.description } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3eb" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={`${title} — ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png?v=walker-2')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16.png?v=walker-2')} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={withBase('/favicon.svg?v=walker-2')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png?v=walker-2')} />
    <title>{title} — {site.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu" tabindex="-1"><slot /></main>
    <Footer />
    <Motion />
  </body>
</html>
