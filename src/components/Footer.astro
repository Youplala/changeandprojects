---
import { withBase } from '../utils/paths';
import { site } from '../data/site';
import Arrow from './Arrow.astro';
import Brand from './Brand.astro';
---
<footer class="site-footer wrap">
  <div class="footer-top"><Brand /><p>Le mouvement commence<br/>avec les personnes.</p><a class="text-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Arrow diagonal /></a></div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Change & Projects</span><span>Formation · Conseil · Accompagnement</span><a href={withBase('/mentions-legales/')}>Mentions légales & confidentialité</a></div>
</footer>
